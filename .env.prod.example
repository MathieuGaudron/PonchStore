# Modèle du fichier .env.prod, à créer À LA MAIN sur le VPS, dans le répertoire
# de déploiement, à côté de docker-compose.prod.yml. Il n'est jamais versionné :
# c'est le seul endroit où vivent les secrets de production.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Le fichier .env.deploy voisin est écrit automatiquement par le workflow CD
# (propriétaire GHCR et tag de l'image) : ne pas le créer soi-même.

# --- Noms de domaine (doivent pointer sur l'IP du VPS en enregistrement A) ---
# Caddy demande un certificat HTTPS pour chacun, automatiquement.
APP_HOST=ponchstore.fr
API_HOST=api.ponchstore.fr

# --- Base de données ---
# Mots de passe forts, différents l'un de l'autre : openssl rand -base64 24
MYSQL_DATABASE=ponchstore
MYSQL_USER=ponchstore
MYSQL_PASSWORD=a-remplacer
MYSQL_ROOT_PASSWORD=a-remplacer-aussi

# --- Symfony ---
APP_ENV=prod
APP_DEBUG=0
# openssl rand -hex 16
APP_SECRET=a-remplacer
APP_SHARE_DIR=var/share

# L'hôte "db" est le nom du service dans docker-compose.prod.yml, pas un domaine.
# Les identifiants doivent être identiques à MYSQL_USER / MYSQL_PASSWORD ci-dessus.
DATABASE_URL=mysql://ponchstore:a-remplacer@db:3306/ponchstore?serverVersion=8.0&charset=utf8mb4

# HS256 impose au moins 32 octets : openssl rand -hex 32
JWT_SECRET=a-remplacer

# --- CORS ---
# Expression régulière, pas une URL. Le front est servi sur APP_HOST et appelle
# l'API sur API_HOST : sans cette autorisation, le navigateur bloque tout appel.
# Les points sont échappés, et il n'y a volontairement pas de guillemets.
CORS_ALLOW_ORIGIN=^https://ponchstore\.fr$

# --- Mail ---
# MailHog n'existe qu'en développement : mettre ici un vrai SMTP.
MAILER_DSN=smtp://identifiant:motdepasse@smtp.exemple.fr:587

# --- URLs utilisées dans les emails et les liens générés ---
FRONT_URL=https://ponchstore.fr
DEFAULT_URI=https://api.ponchstore.fr

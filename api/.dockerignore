# Ce qui ne doit jamais entrer dans l'image de production.
# Sans ce fichier, le "COPY . ." du Dockerfile embarque les secrets locaux
# et écrase le vendor installé en --no-dev par celui du poste de dev.
.env
.env.local
.env.*.local
vendor/
var/
.phpunit.cache/
tests/
phpunit.dist.xml
phpunit.xml
.git/
.gitignore
Dockerfile
Dockerfile.prod
.dockerignore
